# ============================================
# CONFIGURACION PARA TASK WRAPPER
# ============================================
# Nota: Este archivo debe estar en el WORKSPACE
# (mismo nivel que run_cron.sh)
#
# Copia a .env y personaliza:
#   cp .env.example .env

# Rutas (rutas relativas al workspace, o absolutas)
WORKSPACE=/home/kowagunga/workspaces/BurgosEnAbierto/actividades_civicos_burgos
DATA_DIR=docs/data
LOG_DIR=logs

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# NOTIFICACIONES (opcionales)
# ============================================

# Discord webhook (ej: https://discord.com/api/webhooks/...)
# Deja vacío para desactivar notificaciones por Discord
DISCORD_WEBHOOK_URL=

# Email SMTP (para notificaciones por correo)
# Deja vacíos para desactivar email

# Gmail ejemplo:
# 1. Activa 2-Step Verification en https://myaccount.google.com/security
# 2. Genera "App Password" en https://myaccount.google.com/apppasswords
# 3. Copia los valores abajo

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
